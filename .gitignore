# ==========================================
# Core Java Rules
# ==========================================
# Compiled class files
*.class

# Log files
*.log

# Package Files (Uncomment if you want to prevent uploading generated artifacts)
# *.jar
# *.war
# *.nar
# *.ear
# *.zip
# *.tar.gz
# *.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# BlueJ files
*.ctxt

